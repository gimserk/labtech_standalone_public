[Unit]
Description=LabTech Cyber City %i persistent MQTT status and ACK listener
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=labtech
Group=www-data
WorkingDirectory=/opt/labtech
ExecStart=/opt/venv/bin/python /opt/labtech/manage.py listen_cybercity_status --city-id=%i --forever
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
